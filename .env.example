# ============================================
# ENVIRONMENT VARIABLES - barangviral.store
# Salin fail ini sebagai .env dan isi nilai
# ============================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/barangviral?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/barangviral?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="jana-secret-key-anda-di-sini"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# AI - OpenAI (chatbot & radar)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# AI - Gemini (alternatif)
GEMINI_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BarangViral"
